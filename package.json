{
  "name": "react-fi",
  "version": "2.0.0",
  "description": "React library for Feather icons with React 18 & 19 support.",
  "license": "Apache-2.0",
  "author": "MonkeyScript",
  "keywords": [
    "feather-icons",
    "react",
    "feather",
    "icons",
    "svg",
    "react18",
    "react19",
    "tree-shaking"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkeyscript/react-fi.git"
  },
  "bugs": {
    "url": "https://github.com/monkeyscript/react-fi/issues"
  },
  "homepage": "https://github.com/monkeyscript/react-fi#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src/lib/index.d.ts"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/react-fi.cjs",
  "module": "./dist/react-fi.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-fi.js",
      "require": "./dist/react-fi.cjs",
      "default": "./dist/react-fi.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && vite build && npm run copy-types",
    "build:demo": "vite build --config vite.demo.config.js",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "copy-types": "node -e \"require('fs').copyFileSync('src/lib/index.d.ts', 'dist/index.d.ts')\"",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  }
}
